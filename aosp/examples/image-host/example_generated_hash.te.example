type example_generated_hash, domain, coredomain;
type example_generated_hash_exec, exec_type, system_file_type, file_type;
type example_generated_hash_service, service_manager_type;
init_daemon_domain(example_generated_hash)
binder_use(example_generated_hash)
add_service(example_generated_hash, example_generated_hash_service)

# Replace example_image_native_caller with your EXISTING image-owned native caller
